//@version=6
indicator(title="Moving Average Convergence Divergence", shorttitle="MACD", timeframe="", timeframe_gaps=true)
// Getting inputs
fast_length = input(title = "Fast Length", defval = 12)
slow_length = input(title = "Slow Length", defval = 26)
src = input(title = "Source", defval = close)
signal_length = input.int(title = "Signal Smoothing", minval = 1, maxval = 50, defval = 9, display = display.data_window)
sma_source = input.string(title = "Oscillator MA Type", defval = "EMA", options = ["SMA", "EMA"], display = display.data_window)
sma_signal = input.string(title = "Signal Line MA Type", defval = "EMA", options = ["SMA", "EMA"], display = display.data_window)

// Horizontal lines inputs
h_line1 = input.float(title = "Horizontal Line 1", defval = 0.004)
h_line2 = input.float(title = "Horizontal Line 2", defval = -0.004)

// Calculating
fast_ma = sma_source == "SMA" ? ta.sma(src, fast_length) : ta.ema(src, fast_length)
slow_ma = sma_source == "SMA" ? ta.sma(src, slow_length) : ta.ema(src, slow_length)
macd = fast_ma - slow_ma
signal = sma_signal == "SMA" ? ta.sma(macd, signal_length) : ta.ema(macd, signal_length)
hist = macd - signal

// Detect crossovers
crossover_up = ta.crossover(macd, signal)  // MACD crosses above signal
crossover_down = ta.crossunder(macd, signal) // MACD crosses below signal

alertcondition(hist[1] >= 0 and hist < 0, title = 'Rising to falling', message = 'The MACD histogram switched from a rising to falling state')
alertcondition(hist[1] <= 0 and hist > 0, title = 'Falling to rising', message = 'The MACD histogram switched from a falling to rising state')
alertcondition(crossover_up, title = 'MACD crossed above Signal', message = 'MACD line crossed above Signal line')
alertcondition(crossover_down, title = 'MACD crossed below Signal', message = 'MACD line crossed below Signal line')

// Add horizontal lines
hline(0, "Zero Line", color = color.new(#78797e, 40))
hline(h_line1, "Horizontal Line 1", color = color.new(#5ef74a, 0), linestyle = hline.style_dashed)
hline(h_line2, "Horizontal Line 2", color = color.new(#fd8383, 0), linestyle = hline.style_dashed)

// Plot main elements
plot(hist, title = "Histogram", style = plot.style_columns, color = (hist >= 0 ? (hist[1] < hist ? color.rgb(26, 114, 30) : #B2DFDB) : (hist[1] < hist ? #FFCDD2 : #fc2828)))
plot(macd, title = "MACD", color = #2962FF, linewidth = 2)
plot(signal, title = "Signal", color = #FF6D00, linewidth = 2)

// Calculate the exact value where the lines cross
// When a crossover occurs, we plot a cross at the value of MACD/signal (which are equal at crossing)
crossValue = crossover_up or crossover_down ? macd : na

// Plot crossover markers (plus signs) exactly on the line at intersection points
plot(crossover_up ? crossValue : na, title = "Bullish Cross", style = plot.style_circles , linewidth = 3, color = color.rgb(255, 255, 255))
plot(crossover_down ? crossValue : na, title = "Bearish Cross", style = plot.style_cross, linewidth = 3, color = color.rgb(255, 255, 255))
